# Copy to .env.local and fill in. Do NOT commit .env.local.

# ───── Supabase ─────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx          # service role; SERVER ONLY
SUPABASE_TOKEN=sbp_xxx                     # Personal Access Token; for Management API
SUPABASE_CONN_STRING=postgresql://postgres:<pwd>@db.<ref>.supabase.co:5432/postgres

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ───── App ─────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ───── SMTP (nodemailer) ─────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=hello@example.com
SMTP_PASS=app-password
MAIL_FROM=Prime Engage <hello@example.com>
MAIL_TO=hello@example.com

# ───── Razorpay (Phase 3 hybrid redemption) ─────
# Use test keys (rzp_test_*) in dev, production keys in prod. Server-only
# secret stays out of the browser bundle; the public key id is mirrored
# under NEXT_PUBLIC_ for client-side checkout.js init.
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
